{
  "name": "@spectrace/prelim",
  "version": "0.1.0",
  "private": true,
  "description": "Preliminary experiment harness for SpecTrace (Phase A spike): symbol indexing, BM25F retrieval, LLM ranking, and drift evaluation.",
  "type": "module",
  "bin": {
    "spectrace-prelim": "./bin/spectrace-prelim.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@spectrace/core": "workspace:*",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
